            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plano Postman\",\n  \"description\": \"Plano criado pelo Postman para teste de API.\",\n  \"price\": 99.90,\n  \"max_students\": 120,\n  \"max_teachers\": 12,\n  \"status\": 1\n}"
