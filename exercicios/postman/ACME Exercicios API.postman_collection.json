{
  "info": {
    "name": "ACME Exercicios API",
    "description": "Collection organizada para testar os exercicios da API: produtos, categorias de produtos, categorias de FAQ e FAQs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Resposta JSON no padrao da API', function () {",
          "    const json = pm.response.json();",
          "    pm.expect(json).to.have.property('code');",
          "    pm.expect(json).to.have.property('type');",
          "    pm.expect(json).to.have.property('status');",
          "    pm.expect(json).to.have.property('message');",
          "    pm.expect(json).to.have.property('data');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Ex 01 - Listar Produtos",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/list"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Lista de produtos', () => {",
                  "    pm.expect(json.code).to.eql(200);",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data[0]).to.have.property('category_name');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ex 02 - Buscar Produto por ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/list/{{product_id}}"
