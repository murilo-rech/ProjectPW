                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Headset HyperX Cloud II\",\n  \"price\": 349.90,\n  \"category_id\": 1\n}"
            },
            "url": "{{base_url}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Produto criado', () => pm.expect(json.status).to.eql('created'));",
                  "if (json.data && json.data.id) pm.environment.set('product_id_created', json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ex 04 - Criar Produto Invalido",
