              "mode": "raw",
              "raw": "{\n  \"name\": \"Headset HyperX Cloud II Wireless\",\n  \"price\": 499.90,\n  \"category_id\": 1\n}"
            },
            "url": "{{base_url}}/products/{{product_id_created}}"
