            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Produto encontrado', () => {",
                  "    pm.expect(json.code).to.eql(200);",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data).to.have.property('category_name');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ex 02 - Produto ID Invalido",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/list/abc"
